    ng\u01B0\u1EDDi."
  txt_Evacuating: "<b>\u0110\xE3 b\xE1o \u0111\u1ED9ng cho t\xF2a nh\xE0!!</b>\nMau
    ch\xF3ng t\xECm l\u1ED1i tho\xE1t hi\u1EC3m g\u1EA7n nh\u1EA5t."
  txt_ElevatorFail: "<b>NGUY HI\u1EC2M: S\u1EEC D\u1EE4NG THANG M\xC1Y</b>\nTuy\u1EC7t

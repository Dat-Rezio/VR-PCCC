  m_Script: {fileID: 11500000, guid: 7c7b2068a05f98448a4b1a44539b4f34, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::VRPCCC.Scenario2.FirefightingScenarioManager
  m_FridgeFire: {fileID: 1241011920}
  m_BedroomFire: {fileID: 883742515}
  m_HUD: {fileID: 1985626685}
  tutorialCanvas: {fileID: 409250071}
  anchor_StartIdle: {fileID: 0}
  anchor_FirePhase1: {fileID: 0}
  anchor_AtCabinetPhase1: {fileID: 881122993}
  anchor_CheckDistance_Phase1: {fileID: 1377212515}
  anchor_PullPin_Phase1: {fileID: 0}
  anchor_AimNozzle_Phase1: {fileID: 0}
  anchor_Spraying_Phase1: {fileID: 0}
  anchor_Phase1Done: {fileID: 0}
  anchor_FirePhase2: {fileID: 0}
  anchor_AtCabinetPhase2: {fileID: 881122993}
  anchor_CheckDistance_Phase2: {fileID: 719017278}
  anchor_PullPin_Phase2: {fileID: 0}
  anchor_AimNozzle_Phase2: {fileID: 0}
  anchor_Spraying_Phase2: {fileID: 0}
  m_InitialScore: 100
  m_WrongChoicePenalty: 20
  m_ScenarioTimeLimit: 0
  m_MinFireDistance: 2
  m_MaxFireDistance: 3
  txt_StartIdle: "Ng\u1EEDi th\u1EA5y m\xF9i kh\xF3i quanh \u0111\xE2y\nH\xE3y quan
    s\xE1t m\xF4i tr\u01B0\u1EDDng xung quanh..."
  txt_FirePhase1: "<b>PH\xC1T HI\u1EC6N \u0110\xC1M CH\xC1Y T\u1EE6 L\u1EA0NH \u1EDE
    KHU B\u1EBEP!</b>\nH\xE3y nhanh ch\xF3ng ti\u1EBFp c\u1EADn t\u1EE7 PCCC \u1EDF
    g\u1EA7n c\u1EEDa ch\xEDnh."
  txt_FirePhase2: "<b>PH\xC1T HI\u1EC6N \u0110\xC1M CH\xC1Y TRONG PH\xD2NG NG\u1EE6!</b>\nH\xE3y
    nhanh ch\xF3ng ti\u1EBFp c\u1EADn t\u1EE7 PCCC \u1EDF g\u1EA7n c\u1EEDa ch\xEDnh."
  txt_AtCabinetPhase1: "B\u1EA1n \u0111\xE3 ti\u1EBFp c\u1EADn t\u1EE7 b\xECnh ch\u1EEFa
    ch\xE1y!\nH\xE3y ch\u1ECDn \u0110\xDANG lo\u1EA1i b\xECnh kh\xED CO2 (lo\u1EA1i
    b\xECnh c\xF3 loa phun \u1EDF \u0111\u1EA7u v\xF2i phun)."
  txt_AtCabinetPhase2: "B\u1EA1n \u0111\xE3 ti\u1EBFp c\u1EADn t\u1EE7 b\xECnh ch\u1EEFa
    ch\xE1y!\nH\xE3y ch\u1ECDn \u0110\xDANG lo\u1EA1i b\xECnh b\u1ED9t ABC (lo\u1EA1i
    b\xECnh kh\xF4ng c\xF3 loa phun \u1EDF \u0111\u1EA7u v\xF2i phun)."
  txt_CheckDistance: "Di chuy\u1EC3n \u0111\u1EBFn kho\u1EA3ng c\xE1ch an to\xE0n
    kho\u1EA3ng 2\u20133m so v\u1EDBi \u0111\xE1m ch\xE1y."
  txt_PullPin: "B\u1EA1n \u0111ang \u0111\u1EE9ng \u1EDF v\u1ECB tr\xED an to\xE0n
    \u0111\u1EC3 s\u1EED d\u1EE5ng b\xECnh ch\u1EEFa ch\xE1y!\nH\xE3y r\xFAt ch\u1ED1t
    an to\xE0n \u1EDF tr\xEAn \u0111\u1EA7u b\xECnh."
  txt_AimNozzle: "R\xFAt ch\u1ED1t th\xE0nh c\xF4ng!\nH\xE3y h\u01B0\u1EDBng v\xF2i
    phun v\xE0o g\u1ED1c l\u1EEDa."
  txt_Spraying: "B\xF3p c\xF2 v\xE0 gi\u1EEF li\xEAn t\u1EE5c \u0111\u1EC3 d\u1EADp
    l\u1EEDa."
  txt_Phase1Done: "\u0110\xE3 d\u1EADp l\u1EEDa th\xE0nh c\xF4ng!\nNh\u01B0ng khoan
    \u0111\xE3... c\xF3 m\xF9i kh\xF3i ph\xE1t ra t\u1EEB ph\xF2ng ng\u1EE7!"
  OnScenarioStart:
    m_PersistentCalls:
      m_Calls: []
  OnScenarioSuccess:
    m_PersistentCalls:
      m_Calls: []
  OnScenarioFailed:
    m_PersistentCalls:
      m_Calls: []
